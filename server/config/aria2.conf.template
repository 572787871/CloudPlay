dir=/downloads
input-file=/config/aria2.session
save-session=/config/aria2.session
save-session-interval=30
force-save=true
continue=true
allow-overwrite=false
auto-file-renaming=false
file-allocation=none
max-concurrent-downloads=2
split=8
max-connection-per-server=8
min-split-size=4M
connect-timeout=15
timeout=60
max-tries=5
retry-wait=5
check-certificate=true
enable-rpc=true
rpc-listen-all=true
rpc-listen-port=6800
rpc-allow-origin-all=false
rpc-max-request-size=16M
rpc-secret=__RPC_SECRET__
enable-dht=true
enable-dht6=false
enable-peer-exchange=true
listen-port=51425
dht-listen-port=51425
dht-file-path=/config/dht.dat
bt-save-metadata=true
bt-enable-lpd=false
bt-max-peers=100
bt-stop-timeout=300
seed-time=0
seed-ratio=0
max-overall-upload-limit=64K
console-log-level=warn
summary-interval=0
download-result=hide
log-level=warn
